{
  "status": "DRAFT_MOCK",
  "source": "Mock list of 7 Nov 2026 (Kafilat), Urgency rules sheet",
  "note": "MOCK THRESHOLDS FOR THE DEMO. Not verified against Abu Dhabi medical standards. The lab's own range and critical flags on the result always win. The end users decide what is normal and supply the real standards. The system only suggests; a clinician sets the urgency. Where a value falls between two listed bands the helper makes no suggestion and asks for a clinician.",
  "suggestionValues": [
    "urgent",
    "clinician_decides",
    "routine",
    "no_suggestion"
  ],
  "ambiguousNames": {
    "full blood count - haem": "The sub-test is not named (haemoglobin, platelets and so on), so no rule can be chosen.",
    "liver function test - chm": "The sub-test is not named (albumin, enzymes and so on), so no rule can be chosen."
  },
  "tests": [
    {
      "id": "PCV",
      "names": [
        "pcv - haem",
        "pcv",
        "packed cell volume",
        "haematocrit",
        "hematocrit"
      ],
      "kind": "numeric",
      "baseUnit": "%",
      "unitFactors": {
        "%": 1
      },
      "normalRange": [
        37,
        54
      ],
      "referenceText": "37 - 54 %",
      "bands": [
        {
          "id": "PCV-1",
          "when": {
            "lte": 22
          },
          "suggestion": "urgent",
          "reason": "About haemoglobin 7 g/dL or lower: severe anaemia needing same-day review and a transfusion decision",
          "specialty": "General medicine (same day), then Haematology",
          "lookFor": "Chest pain, breathlessness, fainting, bleeding, black stools, pregnancy, a child"
        },
        {
          "id": "PCV-2",
          "when": {
            "gt": 22,
            "lt": 30
          },
          "suggestion": "clinician_decides",
          "reason": "Moderate anaemia. Urgent only with symptoms, pregnancy or a child",
          "specialty": "Haematology or General medicine",
          "lookFor": "Chest pain, breathlessness, fainting, bleeding, black stools, pregnancy, a child"
        },
        {
          "id": "PCV-3",
          "when": {
            "gte": 30,
            "lt": 37
          },
          "suggestion": "routine",
          "reason": "Mild anaemia. Not urgent on its own",
          "specialty": "Primary care; Obstetrics if pregnant",
          "lookFor": "Pregnancy (route to antenatal care), recent bleeding, poor diet"
        },
        {
          "id": "PCV-4",
          "when": {
            "gt": 54
          },
          "suggestion": "clinician_decides",
          "reason": "Raised red cell volume; urgent only with symptoms such as headache, vision change or chest pain",
          "specialty": "Haematology or General medicine",
          "lookFor": "Symptoms, smoking, dehydration"
        }
      ]
    },
