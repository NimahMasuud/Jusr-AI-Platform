# Copy to .env and fill in. NEVER commit .env.

# ---- Which AI helper runs ----
AI_PROVIDER=rules                  # rules (no model, works offline) | openai_compatible (Ollama with Qwen 2.5) | anthropic
SIMULATED_MODE=true                # every suggestion and message says it is simulated (R-05)

# Ollama / LM Studio / vLLM (AI_PROVIDER=openai_compatible)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20

# Anthropic (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5  # check the current model name in Anthropic's docs

# ---- Backend mode (submit suggestions to the Jusr AI backend as the AI_SERVICE user) ----
# The demo seed creates ai@jusr.local with this password. Change both for anything beyond the demo.
BACKEND_URL=http://localhost:8000
AI_SERVICE_EMAIL=ai@jusr.local
AI_SERVICE_PASSWORD=National123!

# ---- Files ----
DATA_DIR=./data_store              # standalone mode saves suggestions and the audit log here
CONFIG_DIR=./config

# ---- Server ----
# Run on 8100 so it does not clash with the API on 8000:
#   uvicorn app.main:app --host 0.0.0.0 --port 8100
